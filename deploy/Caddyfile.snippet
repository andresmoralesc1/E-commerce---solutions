# ─── Ecommerce Brain vhosts ─────────────────────────────────────────────
# Pegado en /etc/caddy/Caddyfile por deploy/caddy-append.sh
# Caddy emite certs automáticos vía Let's Encrypt.

dashboard.ecommerce.andresmorales.com.co {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3040 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
            read_timeout 60s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -X-Powered-By
    }
}

api.ecommerce.andresmorales.com.co {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8040 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
            read_timeout 60s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -X-Powered-By
    }
}

flows.ecommerce.andresmorales.com.co {
    encode zstd gzip
    reverse_proxy 127.0.0.1:5678 {
        header_up X-Real-IP {remote_host}
        header_up Host {host}
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
            read_timeout 60s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Robots-Tag "noindex, nofollow"
        -X-Powered-By
    }
}

wa.ecommerce.andresmorales.com.co {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8088 {
        header_up X-Real-IP {remote_host}
        header_up Host {host}
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
            read_timeout 60s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Robots-Tag "noindex, nofollow"
        -X-Powered-By
    }
}