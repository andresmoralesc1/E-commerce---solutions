{
  "name": "07-whatsapp-webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-webhook",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "name": "Webhook Evolution",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{$json.body.event}}",
              "rightValue": "messages.upsert",
              "operator": {"type": "string", "operation": "equals"}
            },
            {
              "leftValue": "={{$json.body.data.messageType}}",
              "rightValue": "conversation",
              "operator": {"type": "string", "operation": "equals"}
            }
          ]
        },
        "combinator": "and"
      },
      "name": "If user reply",
      "type": "n8n-nodes-base.if",
      "position": [480, 300]
    },
    {
      "parameters": {
        "functionCode": "// Extraer texto del mensaje y detectar SI/NO\nconst body = $json.body || ||;\nconst text = (body.data?.message?.conversation ||\n  body.data?.message?.extendedTextMessage?.text || '').trim().toUpperCase();\nreturn [{json: {phone: body.data?.key?.remoteJid, text, raw: body}}];"
      },
      "name": "Parse reply",
      "type": "n8n-nodes-base.function",
      "position": [700, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"leftValue": "={{$json.text}}", "rightValue": "SI", "operator": {"type": "string", "operation": "equals"}}
          ]
        }
      },
      "name": "SI?",
      "type": "n8n-nodes-base.if",
      "position": [920, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8040/api/agent/confirm-by-phone",
        "bodyParameters": {
          "parameters": [
            {"name": "phone", "value": "={{$json.phone}}"},
            {"name": "approved", "value": "true"}
          ]
        },
        "options": {}
      },
      "name": "Approve action",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1180, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8040/api/agent/confirm-by-phone",
        "bodyParameters": {
          "parameters": [
            {"name": "phone", "value": "={{$json.phone}}"},
            {"name": "approved", "value": "false"}
          ]
        },
        "options": {}
      },
      "name": "Reject action",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1180, 300]
    }
  ],
  "connections": {
    "Webhook Evolution": {"main": [[{"node": "If user reply", "type": "main", "index": 0}]]},
    "If user reply": {"main": [[{"node": "Parse reply", "type": "main", "index": 0}], []]},
    "Parse reply": {"main": [[{"node": "SI?", "type": "main", "index": 0}]]},
    "SI?": {
      "main": [[{"node": "Approve action", "type": "main", "index": 0}], [{"node": "Reject action", "type": "main", "index": 0}]]
    }
  }
}