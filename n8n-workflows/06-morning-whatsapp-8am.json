{
  "name": "06-morning-whatsapp-8am",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"cronExpression": "0 8 * * *"}]}
      },
      "name": "Cron 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8040/api/reports/morning",
        "options": {}
      },
      "name": "POST /api/reports/morning",
      "type": "n8n-nodes-base.httpRequest",
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{$json.ok}}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true"}
            }
          ]
        }
      },
      "name": "If ok",
      "type": "n8n-nodes-base.if",
      "position": [700, 300]
    },
    {
      "parameters": {
        "channel": "#ops-brain",
        "text": "={{'📊 Reporte 8am enviado. ' + $json.actions_sent + ' acciones enviadas.'}}",
        "otherOptions": {}
      },
      "name": "Slack ok",
      "type": "n8n-nodes-base.slack",
      "position": [920, 200]
    },
    {
      "parameters": {
        "channel": "#ops-brain",
        "text": "={{'🚨 Reporte 8am FALLÓ: ' + $json.error}}",
        "otherOptions": {}
      },
      "name": "Slack fail",
      "type": "n8n-nodes-base.slack",
      "position": [920, 400]
    }
  ],
  "connections": {
    "Cron 8am": {"main": [[{"node": "POST /api/reports/morning", "type": "main", "index": 0}]]},
    "POST /api/reports/morning": {"main": [[{"node": "If ok", "type": "main", "index": 0}]]},
    "If ok": {
      "main": [[{"node": "Slack ok", "type": "main", "index": 0}], [{"node": "Slack fail", "type": "main", "index": 0}]]
    }
  }
}